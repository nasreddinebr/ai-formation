# ---------------------------------------------------------------------------
# ai-formation — variables d'environnement
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
# `.env` est ignore par Git ; `.env.example` est versionne.
# ---------------------------------------------------------------------------

# --- Base de donnees -------------------------------------------------------
# Valeur utilisee par les commandes pnpm lancees sur l'hote (`pnpm db:deploy`,
# `pnpm db:health`) : le port Postgres est publie par le service `db`.
# DANS les conteneurs, Docker Compose remplace cette variable par une URL
# pointant vers le nom de service `db` — ne la modifiez pas pour usage conteneur.
DATABASE_URL="postgresql://ai_formation:ai_formation_dev@localhost:5432/ai_formation?schema=public"

# Credentials lus par l'image PostgreSQL (service `db`).
# Ils doivent correspondre a DATABASE_URL ci-dessus.
POSTGRES_USER="ai_formation"
POSTGRES_PASSWORD="ai_formation_dev"
POSTGRES_DB="ai_formation"

# --- Application Next.js ---------------------------------------------------
NODE_ENV="development"
PORT="3000"
HOSTNAME="0.0.0.0"
NEXT_TELEMETRY_DISABLED="1"

# URL publique du site, utilisee pour les metadonnees Open Graph.
NEXT_PUBLIC_SITE_URL="https://ai-formation.dev"

# --- Backend FastAPI -------------------------------------------------------
# Port publie par le service `backend` (docker compose).
BACKEND_PORT="8000"

# Secret de signature des JWT (acces). Generez-en un avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatoire en production ; un secret aleatoire est genere en dev s'il est vide.
JWT_SECRET_KEY="change-me-generate-a-long-random-value"

# Duree de vie des jetons.
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="14"

# Cookies : mettre `true` en production (HTTPS uniquement).
COOKIE_SECURE="false"
# Domaine des cookies (laisser vide pour l'hote courant).
COOKIE_DOMAIN=""

# Origines autorisees par CORS (l'app Next.js passe normalement par le proxy).
CORS_ORIGINS="http://localhost:3000"

# Cree les tables manquantes au demarrage du backend (pratique en dev).
# Mettre `false` en production : les migrations Prisma font foi.
AUTO_CREATE_SCHEMA="true"
# Cree le catalogue de roles + le compte administrateur au demarrage.
SEED_ON_STARTUP="true"

# --- Compte administrateur initial ----------------------------------------
# Cree au premier demarrage avec l'ID 1. Changez le mot de passe apres connexion.
ADMIN_EMAIL="admin@ai-formation.dev"
ADMIN_PASSWORD="Admin_Formation_2026!"
ADMIN_FIRST_NAME="Platform"
ADMIN_LAST_NAME="Administrator"

# --- Proxy Next.js -> FastAPI ---------------------------------------------
# Cible du rewrite Next.js `/backend/*`. En conteneur : nom de service `backend`.
# Sur l'hote (hors Docker) : http://localhost:8000
API_PROXY_TARGET="http://backend:8000"

# Prefixe utilise par le navigateur pour appeler l'API. Vide = meme origine
# (passe par le rewrite `/backend`). Sinon, ex. "http://localhost:8000".
NEXT_PUBLIC_API_BASE=""
